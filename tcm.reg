Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu]
"MUIVerb"="Terminal"
"Icon"="C:\\Windows\\System32\\cmd.exe"
"SubCommands"=""

[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell]

[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\01_cmd]
@="as cmd"
"Icon"="C:\\Windows\\System32\\cmd.exe"

; Modify here the name of the profile in Windows Terminal
[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\01_cmd\command]
@="wt.exe -p \"Command Prompt\" -d \"%1\""

[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\02_pwsh]
@="as powershell"
"Icon"="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"

; Modify here the name of the profile in Windows Terminal
[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\02_pwsh\command]
@="wt.exe -p \"Windows PowerShell\" -d \"%1\""

[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\03_cmd_admin]
@="as admin cmd"
"Icon"="C:\\Windows\\System32\\cmd.exe"
"HasLUAShield"=""

; Use the name of the profile in Windows Terminal
[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\03_cmd_admin\command]
@="wt.exe -p \"Command Prompt (admin)\" -d \"%1\""

[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\04_pwsh_admin]
@="as admin powershell"
"Icon"="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
"HasLUAShield"=""

; Modify here the name of the profile in Windows Terminal
[HKEY_CLASSES_ROOT\Directory\shell\WT_Menu\shell\04_pwsh_admin\command]
@="wt.exe -p \"Windows PowerShell (admin)\" -d \"%1\""
